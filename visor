            --esp) esp="$(need_value "$1" "${2:-}")"; shift 2 ;;
            --cli-dir) cli_dir="$(need_value "$1" "${2:-}")"; shift 2 ;;
            --keep-entry) keep_entry=1; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "unknown uninstall option: $1" ;;
        esac
    done

    esp="$(resolve_esp "$esp" || true)"
    if [ -n "$esp" ] && [ -d "$esp/EFI/visor" ]; then
        say "Removing $esp/EFI/visor"
        run_root rm -rf "$esp/EFI/visor"
    fi
    if [ -n "$cli_dir" ] && [ -f "$cli_dir/visor" ]; then
        say "Removing $cli_dir/visor"
        run_root rm -f "$cli_dir/visor"
    fi
    if [ "$keep_entry" -eq 0 ]; then
        remove_boot_entry
    fi
}

