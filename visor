    local repo="${VISOR_REPO:-$DEFAULT_REPO}"
    local branch="${VISOR_BRANCH:-}"
    local source_dir="${VISOR_SOURCE_DIR:-$(source_dir_default)}"
    local esp=""
    local boot_entry=0
    local sign=0
    local force_config=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --esp) esp="$(need_value "$1" "${2:-}")"; shift 2 ;;
            --repo) repo="$(need_value "$1" "${2:-}")"; shift 2 ;;
            --branch) branch="$(need_value "$1" "${2:-}")"; shift 2 ;;
