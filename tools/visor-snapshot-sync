#!/usr/bin/env bash
set -euo pipefail

ESP="" OS_NAME="" ENTRY_NAME="" SNAPPER_CONFIG="root" LIMIT=12 KERNEL_TPL="" INITRD_TPL=""
while [ $# -gt 0 ]; do
    case "$1" in
        --esp)    ESP=$2; shift 2 ;;
        --os)     OS_NAME=$2; shift 2 ;;
        --entry)  ENTRY_NAME=$2; shift 2 ;;
        --config) SNAPPER_CONFIG=$2; shift 2 ;;
        --limit)  LIMIT=$2; shift 2 ;;
        --kernel) KERNEL_TPL=$2; shift 2 ;;
        --initrd) INITRD_TPL=$2; shift 2 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done

if [ -z "$ESP" ]; then
    for d in /boot/efi /efi /boot; do
        [ -d "$d/EFI" ] && ESP=$d && break
    done
fi
[ -n "$ESP" ] && [ -d "$ESP/EFI" ] || { echo "ESP not found (use --esp)" >&2; exit 1; }

if [ -z "$OS_NAME" ]; then
    OS_NAME=$(. /etc/os-release && echo "$NAME")
fi

OUT_DIR="$ESP/EFI/visor"
OUT="$OUT_DIR/snapshots.conf"
[ -d "$OUT_DIR" ] || { echo "$OUT_DIR does not exist - is Visor installed?" >&2; exit 1; }

base_cmdline=$(tr ' ' '\n' < /proc/cmdline \
    | grep -vE '^(BOOT_IMAGE=|initrd=|rootflags=)' | tr '\n' ' ')
extra_rootflags=$(tr ' ' '\n' < /proc/cmdline | grep '^rootflags=' \
    | sed 's/^rootflags=//' | tr ',' '\n' | grep -v '^subvol' | paste -sd, - || true)

root_subvol=$(findmnt -no OPTIONS / | tr ',' '\n' | sed -n 's/^subvol=\/*//p')

tmp=$(mktemp)
{
    echo "# generated by visor-snapshot-sync $(date '+%Y-%m-%d %H:%M') - do not edit"
} > "$tmp"

emit() {
    local id=$1 date=$2 desc=$3 subvol=$4 rf cmdline kernel initrd
    rf="subvol=/${subvol}"
    [ -n "$extra_rootflags" ] && rf="$rf,$extra_rootflags"
    cmdline="${base_cmdline}rootflags=$rf"
    {
        echo "snapshot {"
        [ -n "$ENTRY_NAME" ] && echo "    entry   = $ENTRY_NAME"
        echo "    os      = $OS_NAME"
        echo "    id      = $id"
        echo "    date    = $date"
        echo "    desc    = $desc"
        [ -n "$KERNEL_TPL" ] && echo "    kernel  = ${KERNEL_TPL//\{id\}/$id}"
        [ -n "$INITRD_TPL" ] && echo "    initrd  = ${INITRD_TPL//\{id\}/$id}"
        echo "    cmdline = $cmdline"
        echo "}"
    } >> "$tmp"
}

count=0
if command -v snapper >/dev/null 2>&1; then
    while IFS= read -r line; do
        num="${line%%,*}"
        rest="${line#*,}"
        date="${rest%%,*}"
        desc="${rest#*,}"
        [ "$num" = "0" ] && continue
        [ -z "$num" ] && continue
        sv="${root_subvol:+$root_subvol/}"
        sv="${sv%/}"; sv="${sv:+$sv/}"
        emit "$num" "${date%:*}" "${desc:--}" "${sv}.snapshots/$num/snapshot"
        count=$((count + 1))
        [ "$count" -ge "$LIMIT" ] && break
    done < <(snapper --machine-readable csv -c "$SNAPPER_CONFIG" list \
             --columns number,date,description 2>/dev/null | tail -n +2 | tac)
elif [ -d /.snapshots ]; then
    for d in $(ls -1 /.snapshots 2>/dev/null | grep -E '^[0-9]+$' | sort -rn); do
        [ -d "/.snapshots/$d/snapshot" ] || continue
        date=$(date -r "/.snapshots/$d/snapshot" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "?")
        sv="${root_subvol:+$root_subvol/}"; sv="${sv%/}"; sv="${sv:+$sv/}"
        emit "$d" "$date" "snapshot" "${sv}.snapshots/$d/snapshot"
        count=$((count + 1))
        [ "$count" -ge "$LIMIT" ] && break
    done
fi

if [ "$count" -eq 0 ]; then
    echo "no snapshots found - removing manifest" >&2
    rm -f "$OUT"
    rm -f "$tmp"
    exit 0
fi

mv "$tmp" "$OUT"
echo "wrote $count snapshot(s) for '$OS_NAME' to $OUT"
